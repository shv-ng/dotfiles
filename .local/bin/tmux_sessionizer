#!/bin/bash

if [[ $# -eq 1 ]]; then
  selected=$1
else
  fd . $HOME/ $HOME/work $HOME/personal --type d --min-depth 1 --max-depth 1 --print0 | frec sync tmux-sessionizer --null
  selected=$(
        frec list tmux-sessionizer | awk -F'  ' '{print $1}' \
      | fzf --tiebreak=index --tmux
    )
fi

if [[ -z $selected ]]; then
  exit 0
fi

frec add tmux-sessionizer $selected

selected_name=$(basename "$selected" | tr . _)
tmux_running=$(pgrep tmux)

if [[ -z $TMUX ]] && [[ -z $tmux_running ]]; then
  tmux new-session -s $selected_name -c $selected
  exit 0
fi

if ! tmux has-session -t=$selected_name 2> /dev/null; then
  tmux new-session -ds $selected_name -c $selected
fi

if [[ -z $TMUX ]]; then
  tmux attach -t $selected_name
  tmux -c vim
else
  tmux switch-client -t $selected_name
fi



