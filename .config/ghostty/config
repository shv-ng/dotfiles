theme = TokyoNight

# Window settings - remove padding for full coverage
window-padding-x = 0
window-padding-y = 0

# Font settings (adjust as needed)
font-family = "JetBrains Mono"
font-size = 14

# Uncomment the next line if colors still appear too bright
term = xterm-256color

confirm-close-surface = false
#background-opacity = 0.9

keybind = alt+one=unbind
keybind = alt+two=unbind
keybind = alt+three=unbind
keybind = alt+four=unbind
keybind = alt+five=unbind
keybind = alt+six=unbind
keybind = alt+seven=unbind
keybind = alt+eight=unbind
keybind = alt+nine=unbind
